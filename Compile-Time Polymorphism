public class Main {
    int add(int a,int b ){
        return a+b;
    }
    double add(double a,double b){
        return a+b;
    }
    int add(int a,int b,int c){
        return a+b+c;
    }
    public static void main(String[] args) {
        Main ob=new Main();
        System.out.println(ob.add(10,20));
        System.out.println(ob.add(10.5,20.4));
        System.out.println(ob.add(10,20,15));
    }
}
