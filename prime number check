import java.util.Scanner;
public class Main {
    public static void main(String a[]) {
       int n,c=0;
       Scanner sc=new Scanner(System.in);
       n=sc.nextInt();
       for(int i=2;i<=n;i++){
           if(n%i==0)c++;
       }
       if(c==1)
       System.out.println("yes");
       else
       System.out.println("no");
    }
}
